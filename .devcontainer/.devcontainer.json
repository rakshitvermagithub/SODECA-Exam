{
  "name": "SODECA Project (Python 3.12 & SQLite)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [5000],

  // Sets environment variables inside the container
  "containerEnv": {
    "FLASK_APP": "app.py",
    "FLASK_ENV": "production",
    "DATABASE_FILE": "students.db",
    "UPLOAD_FOLDER": "static/certificates_folder",
    "GOOGLE_CLIENT_ID": "642587350028-tkpuv44ma8m8qipubqflouakgedouo8q.apps.googleusercontent.com",
    "DRIVE_CLIENT_ID": "642587350028-mrpalbas5ed8sqgesdttb4855mnhgodg.apps.googleusercontent.com"
   },

  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "alexcvzz.vscode-sqlite"
      ]
    }
  }
}